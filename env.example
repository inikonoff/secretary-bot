# Telegram
BOT_TOKEN=
ADMIN_ID=

# Database (Postgres connection string from Supabase: Project Settings -> Database -> Connection string, "URI" / pooled)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional: Supabase project REST credentials (reserved for future Storage API use, not required for MVP)
SUPABASE_URL=
SUPABASE_KEY=

# AI providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

GROQ_MODEL_INTERVIEW=openai/gpt-oss-20b
GROQ_MODEL_FINAL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

OPENROUTER_MODEL_INTERVIEW=google/gemma-4-31b-it:free
OPENROUTER_MODEL_FINAL=minimax/minimax-m3:free

# Webhook (Render Web Service)
WEBHOOK_BASE_URL=https://your-service.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-random-string
PORT=8080

# Telegra.ph /help page (leave empty to auto-create one on first startup)
TELEGRAPH_HELP_URL=

# Tunable limits (defaults match TZ v1.1)
DEBOUNCE_SECONDS=3
RATE_LIMIT_MESSAGES=3
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TEXT_LENGTH=800
MAX_VOICE_SECONDS=60
MAX_FILE_MB=5
MAX_ADD_INFO_CYCLES=3
# Hard cap on adaptive interview questions per application — enforced in code,
# not just suggested to the LLM. Lower this if dialogs still feel too long.
MAX_CLARIFYING_QUESTIONS=3
SAME_TOPIC_ABANDON_THRESHOLD=3
INCOMPLETE_SESSION_REMINDER_HOURS=24

# How often (seconds) to ping the DB just to keep the Supabase free-tier project
# from auto-pausing after ~7 days without activity. Independent from Render's own
# sleep, which UptimeRobot handles by polling /health.
SUPABASE_KEEPALIVE_INTERVAL_SECONDS=21600

LOG_LEVEL=INFO
